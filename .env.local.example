# GitHub personal access token (classic or fine-grained, no special scopes needed —
# it's only used to raise the GraphQL rate limit for reading public profile data).
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Used for absolute Open Graph image URLs. Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct Postgres connection string (Supabase: Project Settings -> Database ->
# Connection string -> URI, transaction pooler / port 6543 recommended for
# serverless). Used by Prisma to log searched username pairs.
DATABASE_URL=
