generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Only this schema is managed by Prisma — "public" (which holds unrelated
  // tables from other projects sharing this database) is deliberately left
  // out so `db push`/`migrate` can never diff or drop anything there.
  schemas  = ["comparecode"]
}

model Search {
  id               BigInt   @id @default(autoincrement())
  githubUsername   String   @map("github_username")
  leetcodeUsername String   @map("leetcode_username")
  createdAt        DateTime @default(now()) @map("created_at")

  // Set once the profile fetch succeeds; left null on lookup failures
  // (e.g. username not found) since there are no stats to record.
  githubTotalContributions Int?    @map("github_total_contributions")
  githubCurrentStreak      Int?    @map("github_current_streak")
  githubTotalStars         Int?    @map("github_total_stars")
  githubRepoCount          Int?    @map("github_repo_count")
  githubTopLanguage        String? @map("github_top_language")

  leetcodeRanking       Int? @map("leetcode_ranking")
  leetcodeTotalSolved   Int? @map("leetcode_total_solved")
  leetcodeEasySolved    Int? @map("leetcode_easy_solved")
  leetcodeMediumSolved  Int? @map("leetcode_medium_solved")
  leetcodeHardSolved    Int? @map("leetcode_hard_solved")

  shipPercent  Int?    @map("ship_percent")
  solvePercent Int?    @map("solve_percent")
  verdict      String? @map("verdict")

  @@map("searches")
  @@schema("comparecode")
}
